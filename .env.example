# Server
PORT=3000
NODE_ENV=development

# Live downloader provider. The default is TikWM's API; replace it with a
# compatible self-hosted or paid provider when appropriate.
TIKTOK_API_ENDPOINT=https://tikwm.com/api/
TIKTOK_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# CORS — comma-separated list of allowed origins in production
ALLOWED_ORIGINS=http://localhost:3000
